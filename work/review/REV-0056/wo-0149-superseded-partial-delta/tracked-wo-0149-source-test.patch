+    venue = state.venue
+    venue_transitions: list[VenueRecoveryTransition] = []
+    created: list[EffectId] = []
+    effect_authority = state._effect_authority_by_id
+    parent_effect_id = record.issued_buy_effect_id
+    if parent_effect_id is not None:
+        stood_down = _authority_stand_down_requested_effect(
+            venue,
+            execution,
+            parent_effect_id,
+            f"m1e-preemption:{item.input_id.value}",
+        )
+        if stood_down is not None:
+            venue, applied = stood_down
+            venue_transitions.extend(applied)
+        try:
+            next_leg = project_next_buy_preemption(
+                venue,
+                execution,
+                parent_effect_id,
+                projection.binding,
+            )
+        except (TypeError, ValueError):
+            return _result(
+                state,
+                AuthorityDisposition.REFUSED,
+                AuthorityReason.VENUE_UNCERTAIN,
+            )
+        if next_leg.can_cancel:
+            cancel_request = build_acquisition_cancel_request(
+                next_leg,
+                _venue_input_id(item.input_id, "preemption-cancel"),
+                EffectId(f"authority:{item.input_id.value}:preemption-cancel"),
+                RequestOccurrenceId(
+                    f"authority:{item.input_id.value}:preemption-cancel"
+                ),
+            )
+            if cancel_request is None:
+                return _result(
+                    state,
+                    AuthorityDisposition.REFUSED,
+                    AuthorityReason.VENUE_UNCERTAIN,
+                )
+            if _authority_effect_identity_conflicts(
+                venue,
+                cancel_request.effect_id,
+                cancel_request.request_occurrence_id,
+                cancel_request.client_order_id,
+            ):
+                return _result(state, AuthorityDisposition.CONFLICT)
+            requested = _authority_request_effect(venue, execution, cancel_request)
+            if requested.disposition is VenueRecoveryDisposition.CONFLICT:
+                return _result(state, AuthorityDisposition.CONFLICT)
+            if requested.disposition is not VenueRecoveryDisposition.APPLIED:
+                return _result(
+                    state,
+                    AuthorityDisposition.REFUSED,
+                    AuthorityReason.VENUE_UNCERTAIN,
+                )
+            venue = requested.book
+            venue_transitions.append(requested)
+            cancel = _broker_request_from_venue_request(cancel_request)
+            effect_authority = _inserted(
+                effect_authority,
+                _effect_key(cancel.effect_id),
+                _EffectAuthorization(
+                    request=cancel,
+                    session_id=projection.currentness.session_id,
+                    manual_flatten_id=None,
+                    emergency_grant_id=None,
+                    route=_EffectRoute.PROTECTION_PREEMPTION_CANCEL,
+                    protection_exit_head=projection.currentness.head,
+                ),
+            )
+            created.append(cancel.effect_id)
+
+    scope_key = _m1e_scope_key(projection.position_scope)
+    next_record = _M1EScopeRecord(
+        currentness=record.currentness,
+        issued_buy_effect_id=record.issued_buy_effect_id,
+        acquisition_creation_head=record.acquisition_creation_head,
+        preemption_latched=True,
+        preemption_binding=projection.binding,
+        protection_exit_effect_id=None,
+        protection_exit_creation_head=None,
+    )
+    next_state = _state_with(
+        state,
+        venue=venue,
+        _effect_authority_by_id=effect_authority,
+        _m1e_by_scope=_replaced(state._m1e_by_scope, scope_key, next_record),
+    )
+    next_state = _record_input(next_state, item)
+    return _result(
+        next_state,
+        AuthorityDisposition.APPLIED,
+        created=tuple(created),
+        venue_transitions=tuple(venue_transitions),
+    )
+
