+def _bound_acquisition_economic_deltas(
+    book: VenueRecoveryBook,
+    prior_execution: ExecutionSnapshot,
+    resulting_execution: ExecutionSnapshot,
+    item: object,
+    disposition: VenueRecoveryDisposition,
+    source_effect_id: EffectId | None,
+) -> tuple[int, Fraction]:
+    """Derive one bound BUY root replacement without a history scan."""
+
+    if disposition is not VenueRecoveryDisposition.APPLIED:
+        return 0, Fraction(0)
+    if type(source_effect_id) is not EffectId:
+        return 0, Fraction(0)
+    effect = book._current_effect(source_effect_id)
+    if (
+        effect is None
+        or effect.scope.kind is not EffectKind.SUBMIT
+        or effect.scope.side is not ExecutionSide.BUY
+        or type(effect.scope.dual_mandate_binding) is not DualMandateBinding
+    ):
+        return 0, Fraction(0)
+    from .recovery import RecordBrokerFillEvidence, RecordBrokerRevisionEvidence
+
+    if type(item) not in {
+        RecordBrokerFillEvidence,
+        RecordBrokerRevisionEvidence,
+    }:
+        return 0, Fraction(0)
+    fact = item.fact
+    after = resulting_execution.root_heads.get(fact.root_key)
+    if (
+        after is None
+        or after.authority is not ExecutionAuthority.BROKER_AUTHORITATIVE
+        or after.current_source_event_id != fact.key.source_event_id
+        or after.scope.side is not ExecutionSide.BUY
+        or after.scope.position_scope != effect.scope.position_scope
+    ):
+        raise ValueError("bound acquisition economics lack an exact current root")
+    before = prior_execution.root_heads.get(fact.root_key)
+    if before is not None and (
+        before.authority is not ExecutionAuthority.BROKER_AUTHORITATIVE
+        or before.scope != after.scope
+    ):
+        raise ValueError("bound acquisition root predecessor is not exact")
+    before_quantity = 0 if before is None else before.signed_quantity
+    before_notional = (
+        Fraction(0)
+        if before is None or before.price is None
+        else before.quantity.value * before.price.exact_value
+    )
+    after_notional = (
+        Fraction(0)
+        if after.price is None
+        else after.quantity.value * after.price.exact_value
+    )
+    return after.signed_quantity - before_quantity, after_notional - before_notional
