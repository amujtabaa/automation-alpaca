+    elif (
+        head is not None
+        and view.execution_binding_matches
+        and view.account_reconciliation_clear
+        and parent.state is BrokerEffectState.ACKNOWLEDGED
+        and parent.acceptance_set_state is AcceptanceSetState.OPEN
+        and not book._has_effect_reconciliation(effect_id)
+    ):
+        owner = book._owner_by_leg.get(_leg_index_key(head))
+        current = book._leg_current_by_leg.get(_leg_index_key(head))
+        if (
+            owner is not None
+            and owner.effect_id == effect_id
+            and current is not None
+            and current.attempt is not None
+            and current.attempt.status
+            in {VenueAttemptState.WORKING, VenueAttemptState.PARTIALLY_FILLED}
+            and current.attempt.pending_operation is None
