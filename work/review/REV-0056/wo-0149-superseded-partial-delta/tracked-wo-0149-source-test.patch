+def _sealed_protection_exit_admission_reason(
+    state: ExecutionAuthorityState,
+    execution: ExecutionSnapshot,
+    item: CreateProtectionExitEffect,
+) -> AuthorityReason | None:
+    """Require a current latched exit, exact closed BUY parents, and a real SELL goal."""
+
+    projection = item.exit_projection
+    record, reason = _preemption_record_for_projection(state, execution, projection)
+    if reason is not None:
+        return reason
+    assert record is not None
+    if (
+        not record.preemption_latched
+        or record.preemption_binding != projection.binding
+        or record.protection_exit_effect_id is not None
+    ):
+        return AuthorityReason.ACQUISITION_CURRENTNESS_STALE
+    if projection.residual is None:
+        return AuthorityReason.VENUE_UNCERTAIN
+    if item.session_id != projection.currentness.session_id:
+        return AuthorityReason.SESSION_MISMATCH
+    fence = _mutation_fence_reason(state)
+    if fence is not None:
+        return fence
+    parent_effect_id = record.issued_buy_effect_id
+    if parent_effect_id is not None:
+        try:
+            preemption = project_next_buy_preemption(
+                state.venue,
+                execution,
+                parent_effect_id,
+                projection.binding,
+            )
+        except (TypeError, ValueError):
+            return AuthorityReason.VENUE_UNCERTAIN
+        if not preemption.is_complete:
+            return AuthorityReason.VENUE_UNCERTAIN
