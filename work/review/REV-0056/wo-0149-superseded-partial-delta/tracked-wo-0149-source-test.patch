+def _begin_protection_preemption(
+    state: ExecutionAuthorityState,
+    execution: ExecutionSnapshot,
+    item: BeginProtectionPreemption,
+) -> ExecutionAuthorityTransition:
+    """Latch one exit and request at most one exact current-leg BUY cancellation."""
+
+    projection = item.exit_projection
+    record, reason = _preemption_record_for_projection(state, execution, projection)
+    if reason is not None:
+        return _result(state, AuthorityDisposition.REFUSED, reason)
+    assert record is not None
+    if record.protection_exit_effect_id is not None:
+        return _result(
+            state,
+            AuthorityDisposition.REFUSED,
+            AuthorityReason.ACQUISITION_CURRENTNESS_STALE,
+        )
+    fence = _mutation_fence_reason(state)
+    if fence is not None:
+        return _result(state, AuthorityDisposition.REFUSED, fence)
