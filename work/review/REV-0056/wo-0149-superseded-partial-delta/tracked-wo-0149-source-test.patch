+def _protection_exit_request(
+    item: CreateProtectionExitEffect,
+) -> BrokerEffectRequest:
+    """Derive one broker-neutral SELL from an opaque, non-waiting exit capability."""
+
+    projection = item.exit_projection
+    residual = projection.residual
+    if residual is None:
+        raise ValueError("waiting protection exit cannot create a SELL effect")
+    return BrokerEffectRequest(
+        effect_id=item.effect_id,
+        request_occurrence_id=item.request_occurrence_id,
+        mandate_id=projection.binding.protection_mandate_id,
+        kind=EffectKind.SUBMIT,
+        client_order_id=item.client_order_id,
+        symbol_id=projection.position_scope.symbol_id,
+        side=ExecutionSide.SELL,
+        quantity=residual,
+        economic_scope=_commit_parts(
+            b"execution-core/m1e-protection-exit-effect-scope/v1",
+            projection.commitment,
+            projection.currentness.head,
+        ),
+        target_leg_key=None,
+        dual_mandate_binding=projection.binding,
+    )
+
