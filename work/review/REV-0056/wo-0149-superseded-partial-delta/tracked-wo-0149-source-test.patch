+def _preemption_record_for_projection(
+    state: ExecutionAuthorityState,
+    execution: ExecutionSnapshot,
+    projection: ProtectionExitProjection,
+) -> tuple[_M1EScopeRecord | None, AuthorityReason | None]:
+    """Resolve one registered composite head without treating copied values as authority."""
+
+    if not projection.is_authentic:
+        return None, AuthorityReason.ACQUISITION_CURRENTNESS_INVALID
+    currentness = projection.currentness
+    scope = currentness.position_scope
+    record = state._m1e_by_scope.get(_m1e_scope_key(scope))
+    if (
+        record is None
+        or record.currentness.head != currentness.head
+        or record.currentness.binding != projection.binding
+    ):
+        return None, AuthorityReason.ACQUISITION_CURRENTNESS_STALE
+    if (
+        scope.broker != state.venue.scope.broker
+        or scope.environment != state.venue.scope.environment
+        or scope.account != state.venue.scope.account
+        or execution.position.scope != scope
+        or currentness.execution_commitment != execution.commitment
+    ):
+        return None, AuthorityReason.EXECUTION_BINDING_MISMATCH
+    if currentness.venue_commitment != state.venue.protection_commitment:
+        return None, AuthorityReason.VENUE_UNCERTAIN
+    if currentness.session_id != state.session_id:
+        return None, AuthorityReason.SESSION_MISMATCH
+    return record, None
